t-size-lg text-capitalize fw-normal\">\r\n                      <i className=\"header-icon lnr-dice me-3 text-muted opacity-6\"> {\" \"} </i>\r\n                      Today's Interviews\r\n                    </div>\r\n                    <div className=\"btn-actions-pane-right actions-icon-btn\">\r\n                      <UncontrolledButtonDropdown>\r\n                        <DropdownToggle className=\"btn-icon btn-icon-only\" color=\"link\">\r\n                          <i className=\"pe-7s-menu btn-icon-wrapper\" />\r\n                        </DropdownToggle>\r\n                        <DropdownMenu className=\"dropdown-menu-shadow dropdown-menu-hover-link\">\r\n                          <DropdownItem header>Change Range</DropdownItem>\r\n                          <DropdownItem>\r\n                            <i className=\"dropdown-icon lnr-inbox\"> </i>\r\n                            <span>Week</span>\r\n                          </DropdownItem>\r\n                          <DropdownItem>\r\n                            <i className=\"dropdown-icon lnr-file-empty\"> </i>\r\n                            <span>Month</span>\r\n                          </DropdownItem>\r\n                          <DropdownItem>\r\n                            <i className=\"dropdown-icon lnr-book\"> </i>\r\n                            <span>Download report</span>\r\n                          </DropdownItem>\r\n                          <DropdownItem divider />\r\n                          <div className=\"p-3 text-end\">\r\n                            <Button className=\"me-2 btn-shadow btn-sm\" color=\"link\">\r\n                              View Details\r\n                            </Button>\r\n                            <Button className=\"me-2 btn-shadow btn-sm\" color=\"primary\">\r\n                              Close\r\n                            </Button>\r\n                          </div>\r\n                        </DropdownMenu>\r\n                      </UncontrolledButtonDropdown>\r\n                    </div>\r\n                  </CardHeader>\r\n                  <CardBody>\r\n                    <DataTable data={data}\r\n                      columns={columns}\r\n                      pagination\r\n                      fixedHeader\r\n                      fixedHeaderScrollHeight=\"370px\"\r\n                    />\r\n                  </CardBody>\r\n                </Card>\r\n              </Col>\r\n              <Col md=\"12\" lg=\"5\" xl=\"4\">\r\n                <Card className=\"mb-3\">\r\n                  <CardHeader className=\"card-header-tab\">\r\n                    <div className=\"card-header-title font-size-lg text-capitalize fw-normal\">\r\n                      <i className=\"header-icon lnr-cloud-download icon-gradient bg-happy-itmeo\"> {\" \"} </i>\r\n                      Alerts\r\n                    </div>\r\n                  </CardHeader>\r\n                  <CardBody className=\"p-0\">\r\n                    <TabbedContent />\r\n                  </CardBody>\r\n                </Card>\r\n              </Col>\r\n            </Row>\r\n            <Card className=\"main-card mb-3\">\r\n              <CardHeader>\r\n                <div className=\"card-header-title font-size-lg text-capitalize fw-normal\">\r\n                  Hiring Managers\r\n                </div>\r\n                <div className=\"btn-actions-pane-right\">\r\n                </div>\r\n              </CardHeader>\r\n              <Table responsive borderless hover className=\"align-middle text-truncate mb-0\">\r\n                <thead>\r\n                  <tr>\r\n                    <th className=\"text-center\">#</th>\r\n                    <th className=\"text-center\">Avatar</th>\r\n                    <th className=\"text-center\">Hirer</th>\r\n                    <th className=\"text-center\">Company</th>\r\n                    <th className=\"text-center\">Recent Hire Status</th>\r\n                    <th className=\"t