\r\n\r\n    if (response.payload) {\r\n      setSuccess(true);\r\n      setMessage(response.payload.message);\r\n    } else {\r\n      setError(true);\r\n    }\r\n  };\r\n\r\n  const closeModal = function () {\r\n    setSuccess(false);\r\n    setError(false);\r\n    props.onCallBack();\r\n  };\r\n\r\n  const [newTabId, setNewTabId] = useState(2);\r\n  const addMoreTabs = function () {\r\n    const newTab = {\r\n      id: 1,\r\n      content: <QualificationModal />,\r\n    };\r\n    setTabs([...tabs, newTab]);\r\n    setNewTabId(newTabId + 1);\r\n  };\r\n  const handlePageChange = function () {\r\n    setPersonalModal(false);\r\n    setEditModal(false);\r\n    props.onCallBack();\r\n  };\r\n  const close = function () {\r\n    setPersonalModal(false);\r\n    setEditModal(false);\r\n  };\r\n\r\n  const getText = function (data) {\r\n    let text = \"\";\r\n    if (data.company != \"\") {\r\n      text = data.company;\r\n      if (data.cityname != \"\" && data.cityname) {\r\n        text += \", \" + data.cityname;\r\n      }\r\n      if (data.statename != \"\" && data.statename) {\r\n        text += \", \" + data.statename;\r\n      }\r\n\r\n      if (data.countryname != \"\" && data.countryname) {\r\n        text += \", \" + data.countryname;\r\n      }\r\n    } else if (data.cityname != \"\") {\r\n      text = data.cityname;\r\n      if (data.statename != \"\" && data.statename) {\r\n        text += \", \" + data.statename;\r\n      }\r\n      if (data.countryname != \"\" && data.countryname) {\r\n        text += \", \" + data.countryname;\r\n      }\r\n    } else if (data.statename != \"\" && data.statename) {\r\n      text = data.statename;\r\n      if (data.countryname != \"\" && data.countryname) {\r\n        text += \", \" + data.countryname;\r\n      }\r\n    } else if (data.countryname != \"\" && data.countryname) {\r\n      text = data.countryname;\r\n      text += data.countryname;\r\n    }\r\n\r\n    return text;\r\n  };\r\n\r\n  const checkEndDate = function (date) {\r\n    if (new Date(date) == new Date()) {\r\n      return \"Present\";\r\n    } else {\r\n      formatDate(date);\r\n    }\r\n  };\r\n\r\n  return (\r\n    <div>\r\n      <div className=\"profile-view\">\r\n        <Card className=\"card-hover-shadow-2x mb-3\">\r\n          <CardBody className=\"scroll-area-md\">\r\n            <div className=\"mb-3\">\r\n              <strong className=\"card-title-text\">Qualifications</strong>\r\n              <Label\r\n                className=\"float-end link-text\"\r\n                onClick={(evt) => setPersonalModal(true)}\r\n              >\r\n                Add\r\n              </Label>\r\n            </div>\r\n            {!loading ? (\r\n              <div>\r\n                <PerfectScrollbar>\r\n                  <Row>\r\n                    {qualificationDetails?.length > 0 ? (\r\n                      qualificationDetails.map((item) => (\r\n                        <div className=\"mb-2\">\r\n                          <Col>\r\n                            <strong className=\"me-2 content-title\">\r\n                              {item.jobtitle}{\" \"}\r\n                            </strong>\r\n                            <div className=\"float-end\">\r\n                              <BsPencil\r\n                                className=\"icons\"\r\n                                onClick={(evt) => edit(item)}\r\n                              />{\" \"}\r\n                              <BsTrash3\r\n                                className=\"icons\"\r\n                                onClick={() =>\r\n                                  deleteData(item.candidatequalificationid)\r\n                                }\r\n                              />\r\n                            </div>\r\n                          </Col>\r\n\r\n                          <span className=\"mb-0 card-p-text-black\">\r\n                            {getText(item)}\r\n                          </span>\r\n\r\n                          {item.startdate ? (\r\n                            <div className=\"card-p-text-black\">\r\n                              {getDate(item)}\r\n                              {calculateExperience(\r\n                                item.startdate,\r\n                                item.enddate\r\n                              )}\r\n                            </div>\r\n                          ) : (\r\n                            <></>\r\n                          )}\r\n                        </div>\r\n                      ))\r\n                    ) : (\r\n                      <div className=\"d-flex justify-content-center\">\r\n                        No Data available\r\n                      </div>\r\n                    )}\r\n                  </Row>\r\n                </PerfectScrollbar>\r\n              </div>\r\n            ) : (\r\n              <div className=\"loader-wrapper d-flex justify-content-center align-items-center loader\">\r\n                <Loader active={loading} type=\"line-scale-pulse-out-rapid\" />\r\n              </div>\r\n            )}\r\n          </CardBody>\r\n        </Card>\r\n      </div>\r\n\r\n      {isPersonalModal ? (\r\n        <div>\r\n          <Modal\r\n            className=\"personal-information\"\r\n            size=\"lg\"\r\n            isOpen={isPersonalModal}\r\n          >\r\n            <ModalHeader toggle={() => close()} charCode=\"Y\">\r\n              <strong className=\"card-title-text\">\r\n                Add/Edit Work Experience\r\n              </strong>\r\n            </ModalHeader>\r\n            <ModalBody>\r\n              <QualificationModal\r\n                OnCallQualification={() => handlePageChange()}\r\n                selected={selectedData}\r\n                check={\"add\"}\r\n              />\r\n            </ModalBody>\r\n          </Modal>\r\n        </div>\r\n      ) : (\r\n        <></>\r\n      )}\r\n\r\n      {viewModal ? (\r\n        <div>\r\n          <Modal className=\"personal-information\" size=\"lg\" isOpen={viewModal}>\r\n            <ModalBody>\r\n              <div>\r\n                <CardBody>\r\n                  <Row className=\"mt-2 mb-3 float-end\">\r\n                    <span\r\n                      className=\"float-end\"\r\n                      style={{ cursor: \"pointer\" }}\r\n                      onClick={() => setViewModal(false)}\r\n                    >\r\n                      X\r\n                    </span>\r\n                  </Row>\r\n                  <Row className=\"mt-3\">\r\n                    {qualificationDetails?.map((item) => (\r\n                      <div>\r\n                        <Col>\r\n                          <strong className=\"me-2 content-title\">\r\n                            {item.jobtitle}{\" \"}\r\n                          </strong>\r\n                        </Col>\r\n\r\n                        <p className=\"mb-0 card-p-text-black\">\r\n                          {item.company}\r\n                          {\", \"}\r\n                          {item.cityname}\r\n                          {\", \"}\r\n                          {item.countryname}\r\n                          {\", \"}\r\n                          {item.zipCode}\r\n                          {\"  \"}\r\n                        </p>\r\n\r\n                        <p className=\"card-p-text-black\">\r\n                          {formatDate(item.startdate)}\r\n                          {\" to \"}\r\n                          {checkEndDate(item.enddate)}\r\n                          {\" (\"}\r\n                          {item.experience}\r\n                          {\")\"}\r\n                        </p>\r\n\r\n                        {/* <p className=\"card-p-text\">{item.jobDescription}</p> */}\r\n                      </div>\r\n                    ))}\r\n                  </Row>\r\n                </CardBody>\r\n                <CardFooter>\r\n                  <div className=\"float-end\">\r\n                    <Button\r\n                      type=\"button\"\r\n                      className=\"close-btn\"\r\n                      onClick={() => setViewModal(false)}\r\n                    >\r\n                      Close\r\n                    </Button>\r\n                  </div>\r\n                </CardFooter>\r\n              </div>\r\n            </ModalBody>\r\n          </Modal>\r\n        </div>\r\n      ) : (\r\n        <></>\r\n      )}\r\n\r\n      {editModal ? (\r\n        <div>\r\n          <Modal className=\"personal-information\" size=\"lg\" isOpen={editModal}>\r\n            <ModalHeader toggle={() => close()} charCode=\"Y\">\r\n              <strong className=\"card-title-text\">\r\n                Add/Edit Work Experience\r\n              </strong>\r\n            </ModalHeader>\r\n            <ModalBody>\r\n              <QualificationModal\r\n                OnCallQualification={() => handlePageChange()}\r\n                selected={selectedData}\r\n                check={\"edit\"}\r\n              />\r\n            </ModalBody>\r\n          </Modal>\r\n        </div>\r\n      ) : (\r\n        <></>\r\n      )}\r\n      <Modal className=\"modal-reject-align profile-view\" isOpen={success}>\r\n        <Card>\r\n          <CardBody>\r\n            <div className=\"d-flex justify-content-center mb-3\">\r\n              <img src={successIcon} alt=\"success-icon\" />\r\n            </div>\r\n            <div className=\"mb-0 d-flex justify-content-center rejected-success-text\">\r\n              {message}\r\n            </div>\r\n            <div className=\"mb-3 d-flex justify-content-center rejected-success-text\">\r\n              {\" \"}\r\n            </div>\r\n            <div>\r\n              <Row>\r\n                <Col className=\"d-flex justify-content-center\">\r\n                  <Button\r\n                    className=\"me-2 accept-modal-btn\"\r\n                    onClick={(evt) => closeModal()}\r\n                  >\r\n                    OK\r\n                  </Button>\r\n                </Col>\r\n              </Row>\r\n            </div>\r\n          </CardBody>\r\n        </Card>\r\n      </Modal>\r\n\r\n      <Modal className=\"modal-reject-align profile-view\" isOpen={error}>\r\n        <Card>\r\n          <CardBody>\r\n            <div className=\"d-flex justify-content-center mb-3\">\r\n              <img src={errorIcon} alt=\"success-icon\" />\r\n            </div>\r\n            <div className=\"mb-0 d-flex justify-content-center rejected-success-text\">\r\n              Something went wrong\r\n            </div>\r\n            <div className=\"mb-3 d-flex justify-content-center rejected-success-text\">\r\n              {\" \"}\r\n              Please try again later\r\n            </div>\r\n            <div>\r\n              <Row>\r\n                <Col className=\"d-flex justify-content-center\">\r\n                  <Button\r\n                    className=\"me-2 accept-modal-btn\"\r\n                    onClick={(evt) => setError(false)}\r\n                  >\r\n                    OK\r\n                  </Button>\r\n                </Col>\r\n              </Row>\r\n            </div>\r\n          </CardBody>\r\n        </Card>\r\n      </Modal>\r\n    </div>\r\n  );\r\n}\r\n","C:\\workspace\\projects\\panther\\panther-web\\src\\_containers\\candidate\\resumeDetails.js",["1090","1091","1092","1093","1094","1095","1096","1097","1098","1099","1100"],"import React, { useState, useEffect, useRef } from \"react\";\r\nimport { Label, ModalBody } from \"reactstrap\";\r\nimport {\r\n  Row,\r\n  Col,\r\n  Modal,\r\n  ModalHeader,\r\n  Card,\r\n  CardBody,\r\n  Button,\r\n  FormGroup,\r\n  CardTitle,\r\n} from \"reactstrap\";\r\nimport { formatDate } from \"_helpers/helper\";\r\nimport { profileActions } from \"_store\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { BsDownload, BsTrash3, BsUpload } from \"react-icons/bs\";\r\nimport axios from \"axios\";\r\nimport \"./profile.scss\";\r\nimport successIcon from \"../../assets/utils/images/success_icon.svg\";\r\nimport { useDropzone } from \"react-dropzone\";\r\nimport Loader from \"react-loaders\";\r\nimport errorIcon from \"../../assets/utils/images/error_icon.png\";\r\n\r\nimport { ProfilePDF } from \"./profilePDF\";\r\nimport CardHeader from \"react-bootstrap/esm/CardHeader\";\r\n\r\nexport function ResumeDetails(props) {\r\n  const dispatch = useDispatch();\r\n\r\n  const resumeDetails = useSelector(\r\n    (state) => state.getProfile.profileData.resumeInfo\r\n  );\r\n  const resumeTemplate = useSelector(\r\n    (state) => state.getResumeTemplate.user.data\r\n  );\r\n  const [candidateDetails, setCandidateDetails] = useState(\r\n    props.candidateDetails\r\n  );\r\n  const [fileName, setFileName] = useState(\"\");\r\n  const [success, setSuccess] = useState(false);\r\n  const [message, setMessage] = useState(\"\");\r\n  const [error, setError] = useState(false);\r\n  const [sizeError, setSizeError] = useState(false);\r\n  const [isModal, setModal] = useState(false);\r\n  const [deleteConfirmation, setDeleteConfirm] = useState(false);\r\n  const [buildModal, setBuildModal] = useState(false);\r\n\r\n  let url = `${process.env.REACT_APP_PANTHER_URL}`;\r\n\r\n  const loading = useSelector((state) => state.getProfile.loader);\r\n\r\n  useEffect(() => {\r\n    getFileName();\r\n  }, []);\r\n\r\n  const addEditResumeDetails = function () {\r\n    setModal(true);\r\n  };\r\n  const closeModal = function () {\r\n    setSuccess(false);\r\n    setError(false);\r\n    props.onCallBack();\r\n  };\r\n\r\n  const addEditResume = async function (acceptedFiles) {\r\n    const config = {\r\n      headers: {\r\n        \"content-type\": \"multipart/form-data\",\r\n      },\r\n    };\r\n\r\n    if (resumeDetails) {\r\n      const form = new FormData();\r\n      form.append(\"Candidateresumeid\", resumeDetails.candidateresumeid);\r\n      form.append(\r\n        \"Candidateid\",\r\n        JSON.parse(localStorage.getItem(\"userDetails\")).InternalUserId\r\n      );\r\n      form.append(\"Resumepath\", \"\");\r\n      form.append(\"Resumefile\", acceptedFiles[0]);\r\n      form.append(\"Isparsed\", false);\r\n      form.append(\r\n        \"CurrentUserId\",\r\n        JSON.parse(localStorage.getItem(\"userDetails\")).UserId\r\n      );\r\n      let candidateresumeid = resumeDetails.candidateresumeid;\r\n\r\n      axios\r\n        .put(\r\n          `${url}/PutResume/` + resumeDetails.candidateresumeid,\r\n          form,\r\n          config\r\n        )\r\n        .then((result) => {\r\n          if (result.data.statusCode == 204) {\r\n            setSuccess(true);\r\n            setMessage(result.data.message);\r\n          } else {\r\n            setError(true);\r\n          }\r\n        })\r\n        .catch((error) => {});\r\n    } else {\r\n      const form = new FormData();\r\n      form.append(\r\n        \"Candidateid\",\r\n        JSON.parse(localStorage.getItem(\"userDetails\")).InternalUserId\r\n      );\r\n      form.append(\"Resumefile\", acceptedFiles[0]);\r\n\r\n      axios\r\n        .post(`${url}/PostResume`, form, config)\r\n        .then((result) => {\r\n          if (result.data) {\r\n            if (result.data.status == \"Success\") {\r\n              setSuccess(true);\r\n              setMessage(result.data.message);\r\n            } else {\r\n              setError(true);\r\n            }\r\n          } else {\r\n            setError(true);\r\n          }\r\n        })\r\n        .catch((error) => {});\r\n    }\r\n  };\r\n\r\n  const close = function () {\r\n    setBuildModal(false);\r\n  };\r\n\r\n  const deleteResume = async function () {\r\n    let resumeId = resumeDetails.candidateresumeid;\r\n\r\n    let response = await dispatch(profileActions.deleteResume(resumeId));\r\n    if (response.payload) {\r\n      setSuccess(true);\r\n      setMessage(response.payload.message);\r\n    } else {\r\n      setError(true);\r\n    }\r\n\r\n    setDeleteConfirm(false);\r\n    props.onCallBack();\r\n  };\r\n\r\n  const onDrop = (acceptedFiles) => {\r\n    if (acceptedFiles[0].size > 5 * 1024 * 1024) {\r\n      setSizeError(true);\r\n\r\n      return;\r\n    }\r\n\r\n    addEditResume(acceptedFiles);\r\n  };\r\n\r\n  const { getRootProps, getInputProps } = useDropzone({\r\n    onDrop,\r\n    accept: \".pdf, .docx, .rtf\",\r\n  });\r\n\r\n  const getFileName = function () {\r\n    let name = \"\";\r\n\r\n    if (resumeDetails) {\r\n      if (resumeDetails.resumepath) {\r\n        const lastIndex = resumeDetails.resumepath.lastIndexOf(\".\");\r\n        let jobTitle = candidateDetails.position\r\n          ? candidateDetails.position.replace(/ /g, \"_\")\r\n          : \"\";\r\n        if (lastIndex !== -1) {\r\n          name =\r\n            candidateDetails.lastname +\r\n            (jobTitle ? \"_\" + jobTitle : \"\") +\r\n            \".\" +\r\n            resumeDetails.resumepath.slice(lastIndex + 1);\r\n        }\r\n      }\r\n      setFileName(name);\r\n    }\r\n  };\r\n\r\n  const handlePrint = function () {\r\n    setBuildModal(true);\r\n  };\r\n  const handleChange = function (data) {};\r\n\r\n  return (\r\n    <div>\r\n      <div className=\"profile-view\">\r\n        <Card className=\"card-hover-shadow-2x mb-3\">\r\n          <CardBody className=\"scroll-area-lg\">\r\n            <div className=\"mb-3\">\r\n              <strong className=\"card-title-text\">Resume</strong>\r\n            </div>\r\n\r\n            {!loading ? (\r\n              <div>\r\n                <Row>\r\n                  <Label className=\"card-p-text\">\r\n                    The recommendation is to utilize the build resume option for\r\n                    improved job matching\r\n                  </Label>\r\n                </Row>\r\n\r\n                {resumeDetails ? (\r\n                  <Row className=\"mb-1\">\r\n                    {resumeDetails.resumepath ? (\r\n                      <div>\r\n                        <strong className=\"content-title\">\r\n                          <span className=\"me-2\">{fileName}</span>{\" \"}\r\n                          <a\r\n                            target=\"blank\"\r\n                            href={resumeDetails.resumepath}\r\n                            download={fileName}\r\n                            className=\"me-2\"\r\n                          >\r\n                            <BsDownload />\r\n                          </a>\r\n                          <BsTrash3 onClick={() => setDeleteConfirm(true)} />\r\n                        </strong>\r\n                        <div className=\"card-p-text\">\r\n                          Uploaded on {formatDate(resumeDetails.uploadeddate)}\r\n                        </div>\r\n                      </div>\r\n                    ) : (\r\n                      <></>\r\n                    )}\r\n                  </Row>\r\n                ) : (\r\n                  <></>\r\n                )}\r\n\r\n                <Row>\r\n                  <p>\r\n                    <BsDownload />\r\n                    <a\r\n                      href={resumeTemplate?.[0]?.name}\r\n                      download=\"Resume_Template.docx\"\r\n                      className=\"card-p-text-black\"\r\n                      style={{ color: \"#2F479B\", marginLeft: \"2px\" }}\r\n                    >\r\n                      Click here{\" \"}\r\n                    </a>\r\n                    <Label className=\"card-p-text-black\">\r\n                      to download standard template\r\n                    </Label>\r\n                  </p>\r\n                </Row>\r\n                <Row>\r\n                  <Col className=\"col-12 mb-2\">\r\n                    <div className=\" div-box\">\r\n                      <div className=\" mb-2 card-p-text-black\">\r\n                        Upload your resume here\r\n                      </div>\r\n                      <Row>\r\n                        <div {...getRootProps()} className=\"dropzone\">\r\n                          <input {...getInputProps()} />\r\n                          <Row>\r\n                            <label>\r\n                              <div\r\n                                className=\"dropZone\"\r\n                                id=\"dragbox\"\r\n                                onChange={handleChange}\r\n                              >\r\n                                <Button\r\n                                  style={{\r\n                                    width: \"auto\",\r\n                                    backgroundColor: \"#2F2E2E\",\r\n                                    borderColor: \"#2F2E2E\",\r\n                                    float: \"left\",\r\n                                    marginRight: \"15px\",\r\n                                  }}\r\n                                  className=\"mb-2 mt-0 btn-icon btn-pill btn-text\"\r\n                                  color=\"primary\"\r\n                                >\r\n                                  <span className=\"me-2\">\r\n                                    <BsUpload />\r\n                                  </span>\r\n\r\n                                  <span className=\"me-2\">Upload</span>\r\n                                </Button>\r\n                                <div\r\n                                  className=\"file-info\"\r\n                                  style={{ paddingTop: \"10px\" }}\r\n                                >\r\n                                  Support formats:doc, docx, pdf,rtf, upto 5 MB\r\n                                </div>\r\n                              </div>\r\n                            </label>\r\n                          </Row>\r\n                        </div>\r\n                      </Row>\r\n                    </div>\r\n                  </Col>\r\n\r\n                  <Col className=\"col-12\">\r\n                    <div className=\"div-box build-resume-box\">\r\n                      <div className=\"mb-2 card-p-text-black\">\r\n                        Build your own resume\r\n                      </div>\r\n\r\n                      <div className=\"file-info\">\r\n                        <div className=\"mb-2\">\r\n                          The system generates a standard resume format by\r\n                          incorporating all necessary information from the\r\n                          candidate profile page, including demographics, work\r\n                          experience, education, skills, certifications,\r\n                          licenses, languages, and summary.\r\n                        </div>\r\n                        <span className=\"mt-2\">\r\n                          <FormGroup>\r\n                            <Row style={{ marginLeft: \"5px\" }}>\r\n                              <Button\r\n                                style={{\r\n                                  width: \"auto\",\r\n                                  backgroundColor: \"#2F479B\",\r\n                                }}\r\n                                className=\"me-2 btn-icon btn-pill btn-text\"\r\n                                color=\"primary\"\r\n                                onClick={() => handlePrint()}\r\n                              >\r\n                                <span className=\"me-2\">\r\n                                  <BsUpload />\r\n                                </span>\r\n\r\n                                <span className=\"me-2\">Build</span>\r\n                              </Button>\r\n                            </Row>\r\n                          </FormGroup>\r\n                        </span>\r\n                        After submitting all necessary data.\r\n                      </div>\r\n                    </div>\r\n                  </Col>\r\n                </Row>\r\n              </div>\r\n            ) : (\r\n              <div className=\"loader-wrapper d-flex justify-content-center align-items-center loader\">\r\n                <Loader active={loading} type=\"line-scale-pulse-out-rapid\" />\r\n              </div>\r\n            )}\r\n          </CardBody>\r\n        </Card>\r\n      </div>\r\n\r\n      <Modal\r\n        className=\"modal-reject-align profile-view\"\r\n        isOpen={deleteConfirmation}\r\n      >\r\n        <Card>\r\n          <CardBody>\r\n            <div className=\"d-flex justify-content-center mb-3\">\r\n              <img src={errorIcon} alt=\"success-icon\" />\r\n            </div>\r\n            <div className=\"mb-0 d-flex justify-content-center rejected-success-text\">\r\n              Are you sure\r\n            </div>\r\n            <div className=\"mb-3 d-flex justify-content-center rejected-success-text\">\r\n              {\" \"}\r\n              want to delete the Resume!!\r\n            </div>\r\n            <div>\r\n              <Row>\r\n                <Col className=\"d-flex justify-content-center\">\r\n                  <Button\r\n                    className=\"me-2 accept-modal-btn\"\r\n                    onClick={(evt) => deleteResume()}\r\n                  >\r\n                    YES\r\n                  </Button>\r\n                  <Button\r\n                    className=\"success-close-btn\"\r\n                    onClick={(evt) => setDeleteConfirm(false)}\r\n                  >\r\n                    NO\r\n                  </Button>\r\n                </Col>\r\n              </Row>\r\n            </div>\r\n          </CardBody>\r\n        </Card>\r\n      </Modal>\r\n\r\n      <Modal className=\"modal-reject-align profile-view\" isOpen={success}>\r\n        <Card>\r\n          <CardBody>\r\n            <div className=\"d-flex justify-content-center mb-3\">\r\n              <img src={successIcon} alt=\"success-icon\" />\r\n            </div>\r\n            <div className=\"mb-0 d-flex justify-content-center rejected-success-text\">\r\n              {message}\